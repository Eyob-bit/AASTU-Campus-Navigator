generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LandmarkCategory {
  FOOD
  EDUCATION
  SPORTS
  ADMINISTRATION
  TRANSPORT
  EMERGENCY
  RECREATION
  RELIGIOUS
  SERVICES
  CUSTOM
}

enum SceneElementType {
  ARROW
  OFFICE_LABEL
  INFORMATION
}

enum RoadNodeType {
  INTERSECTION
  GATE
  BUILDING_ENTRANCE
  WALKWAY
}


model BuildingComplex {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  zone        String?
  coverImage  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks      Building[]        @relation("ComplexBlocks")
  connections BlockConnection[] @relation("ComplexConnections")

  @@index([name])
}

enum ConnectionType {
  BRIDGE
  WALKWAY
  SKYWALK
  TUNNEL
}

model Building {
  id            String   @id @default(cuid())
  name          String
  isActive      Boolean  @default(true)
  code          String   @unique
  entranceLatitude  Float
  entranceLongitude Float
  entranceImage String?
  coverImage    String?
  logo          String?
  themeColor    String?
  zone          String?
  entranceRoadNodeId String?
  complexId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  complex       BuildingComplex?  @relation("ComplexBlocks", fields: [complexId], references: [id], onDelete: SetNull)
  entrances     BuildingEntrance[] @relation("BuildingEntrances")
  connectionsFrom BlockConnection[] @relation("BlockConnectionFrom")
  connectionsTo   BlockConnection[] @relation("BlockConnectionTo")

  floors        Floor[]
  announcements Announcement[]
  landmarks     Landmark[]
  entranceRoadNode RoadNode? @relation("BuildingEntrance", fields: [entranceRoadNodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([complexId])
}

model BuildingEntrance {
  id          String   @id @default(cuid())
  name        String
  buildingId  String
  latitude    Float
  longitude   Float
  image       String?
  isPrimary   Boolean  @default(false)
  roadNodeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building  @relation("BuildingEntrances", fields: [buildingId], references: [id], onDelete: Cascade)
  roadNode    RoadNode? @relation("DedicatedEntranceNode", fields: [roadNodeId], references: [id], onDelete: SetNull)

  @@index([buildingId])
  @@index([roadNodeId])
}

model BlockConnection {
  id              String         @id @default(cuid())
  name            String
  type            ConnectionType @default(BRIDGE)
  fromBuildingId  String
  toBuildingId    String
  fromFloorId     String?
  toFloorId       String?
  fromSceneId     String?
  toSceneId       String?
  description     String?
  isWalkable      Boolean        @default(true)
  complexId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromBuilding    Building        @relation("BlockConnectionFrom", fields: [fromBuildingId], references: [id], onDelete: Cascade)
  toBuilding      Building        @relation("BlockConnectionTo", fields: [toBuildingId], references: [id], onDelete: Cascade)
  fromFloor       Floor?          @relation("FloorConnectionFrom", fields: [fromFloorId], references: [id], onDelete: SetNull)
  toFloor         Floor?          @relation("FloorConnectionTo", fields: [toFloorId], references: [id], onDelete: SetNull)
  fromScene       PanoramaScene?  @relation("SceneConnectionFrom", fields: [fromSceneId], references: [id], onDelete: SetNull)
  toScene         PanoramaScene?  @relation("SceneConnectionTo", fields: [toSceneId], references: [id], onDelete: SetNull)
  complex         BuildingComplex? @relation("ComplexConnections", fields: [complexId], references: [id], onDelete: SetNull)

  @@index([fromBuildingId])
  @@index([toBuildingId])
  @@index([complexId])
}

model Floor {
  id          String   @id @default(cuid())
  floorNumber Int
  buildingId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  offices Office[]
  scenes  PanoramaScene[]
  connectionsFrom BlockConnection[] @relation("FloorConnectionFrom")
  connectionsTo   BlockConnection[] @relation("FloorConnectionTo")

  @@unique([buildingId, floorNumber])
}

model Office {
  id          String  @id @default(cuid())
  name        String
  roomNumber  String
  description String?

  floorId String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  staff         Staff[]
  aliases       SearchAlias[]
  sceneElements SceneElement[]
  announcements Announcement[]

  @@unique([floorId, roomNumber])
  @@index([roomNumber])
  @@index([name])
}

model Staff {
  id String @id @default(cuid())

  fullName String
  position String

  email String?
  phone String?

  officeId String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  aliases SearchAlias[]

  @@index([position])
  @@index([fullName])
}

model SearchAlias {
  id String @id @default(cuid())

  alias           String
  normalizedAlias String

  officeId String?
  staffId  String?

  office Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)
  staff  Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([normalizedAlias, officeId])
  @@unique([normalizedAlias, staffId])
}

model PanoramaScene {
  id           String @id @default(cuid())
  key          String @unique
  name         String
  imagePath          String
  imageFilename      String?
  cloudinaryPublicId String?
  displayOrder       Int      @default(0)
  isEntryScene Boolean @default(false)

  floorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  elements SceneElement[] @relation("SceneElements")

  nextScenes SceneElement[] @relation("SceneNavigation")

  connectionsFrom BlockConnection[] @relation("SceneConnectionFrom")
  connectionsTo   BlockConnection[] @relation("SceneConnectionTo")

  @@unique([floorId, displayOrder])
}

model SceneElement {
  id String @id @default(cuid())
  displayOrder Int @default(0)
  isVisible    Boolean @default(true)
  updatedAt DateTime @updatedAt

  type SceneElementType

  label String?

  x Float
  y Float

  rotation Float?

  sceneId String

  officeId String?

  nextSceneId String?

  createdAt DateTime @default(now())

  scene PanoramaScene @relation("SceneElements", fields: [sceneId], references: [id], onDelete: Cascade)

  office Office? @relation(fields: [officeId], references: [id])

  nextScene PanoramaScene? @relation("SceneNavigation", fields: [nextSceneId], references: [id])

  @@unique([sceneId, displayOrder])
}

model Announcement {
  id String @id @default(cuid())

  title   String
  message String

  buildingId String

  officeId String?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  office Office? @relation(fields: [officeId], references: [id])

  @@index([expiresAt])
}

model Landmark {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    LandmarkCategory @default(CUSTOM)
  latitude    Float
  longitude   Float
  icon        String?
  image       String?
  isVisible   Boolean          @default(true)
  buildingId  String?
  roadNodeId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  building    Building?        @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  roadNode    RoadNode?        @relation("LandmarkNode", fields: [roadNodeId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([name])
  @@index([buildingId])
}

model RoadNode {
  id        String       @id @default(cuid())
  name      String?
  type      RoadNodeType @default(INTERSECTION)
  zone      String?
  mapZoom   Float?
  latitude  Float
  longitude Float
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  outgoingEdges RoadEdge[] @relation("FromNode")
  incomingEdges RoadEdge[] @relation("ToNode")

  buildingEntrances Building[]         @relation("BuildingEntrance")
  dedicatedEntrances BuildingEntrance[] @relation("DedicatedEntranceNode")
  landmarks         Landmark[]         @relation("LandmarkNode")

  @@index([type])
  @@index([zone])
}

model RoadEdge {
  id              String   @id @default(cuid())
  fromNodeId      String
  toNodeId        String
  distance        Float
  isBidirectional Boolean  @default(true)
  isWalkable      Boolean  @default(true)
  createdAt       DateTime @default(now())

  fromNode RoadNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   RoadNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int      @default(0)
  hasResults  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@index([hasResults])
}

model NavigationLog {
  id               String    @id @default(cuid())
  destinationName  String?
  destinationId    String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  cancelled        Boolean   @default(false)
  walkingDistanceM Float?

  @@index([startedAt])
  @@index([destinationId])
}

model AdminProfile {
  id          String   @id @default(cuid())
  fullName    String   @default("Admin User")
  email       String   @default("admin@aastu.edu.et")
  role        String   @default("Super Admin")
  avatarUrl   String?  @db.Text
  passwordHash String  @default("admin")
  updatedAt   DateTime @updatedAt
}

model ChatLog {
  id            String   @id @default(cuid())
  sessionKey    String?
  message       String
  intent        String
  confidence    Float    @default(0)
  matchedEntity String?
  responseType  String   @default("general")
  hasMatch      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([intent])
  @@index([hasMatch])
}

// ── Information Page Content (admin-editable) ──────────────────────────────

model InfoChannel {
  id          String   @id @default(cuid())
  label       String
  url         String
  platform    String   @default("telegram")  // telegram | facebook | youtube | tiktok | website
  colorClass  String   @default("text-sky-400 bg-sky-500/10")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model InfoContact {
  id        String   @id @default(cuid())
  type      String   @default("phone")  // phone | email
  label     String
  value     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model InfoLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  iconName  String   @default("Link")  // Lucide icon name
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}
