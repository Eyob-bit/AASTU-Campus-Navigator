generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SceneElementType {
  ARROW
  OFFICE_LABEL
  INFORMATION
}

model Building {
  id             String   @id @default(cuid())
  name           String
  isActive Boolean @default(true)
  code           String   @unique
  latitude       Float
  longitude      Float
  entranceImage  String?
  coverImage     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  floors         Floor[]
  announcements  Announcement[]
  @@index([name])
}

model Floor {
  id          String   @id @default(cuid())
  floorNumber Int
  buildingId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  offices     Office[]
  scenes      PanoramaScene[]

  @@unique([buildingId, floorNumber])
}

model Office {
  id           String   @id @default(cuid())
  name         String
  roomNumber   String
  @@index([roomNumber])
  description  String?

  floorId      String

  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floor         Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)

  staff         Staff[]
  aliases       SearchAlias[]
  sceneElements SceneElement[]

  @@unique([floorId, roomNumber])
  @@index([name])
}

model Staff {
  id          String   @id @default(cuid())

  fullName    String
  position    String
  @@index([position])

  email       String?
  phone       String?

  officeId    String

  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office       Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)

  aliases      SearchAlias[]
  @@index([fullName])
}

model SearchAlias {
  id        String @id @default(cuid())

  alias     String
  normalizedAlias String 

  officeId  String?
  staffId   String?

  office    Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([alias, officeId])
  @@unique([alias, staffId])
  @@index([normalizedAlias])
}

model PanoramaScene {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  imagePath String
  displayOrder Int @default(0)

  floorId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor      Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  elements   SceneElement[] @relation("SceneElements")

  nextScenes SceneElement[] @relation("SceneNavigation")
}

model SceneElement {
  id          String @id @default(cuid())

  type        SceneElementType

  label       String?

  x           Float
  y           Float

  rotation    Float?

  sceneId     String

  officeId    String?

  nextSceneId String?

  createdAt   DateTime @default(now())

  scene        PanoramaScene @relation("SceneElements", fields: [sceneId], references: [id], onDelete: Cascade)

  office       Office? @relation(fields: [officeId], references: [id])

  nextScene    PanoramaScene? @relation("SceneNavigation", fields: [nextSceneId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())

  title       String
  message     String

  buildingId  String

  officeId    String?

  expiresAt   DateTime?

  createdAt   DateTime @default(now())

  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  office       Office? @relation(fields: [officeId], references: [id])
  @@index([expiresAt])
}